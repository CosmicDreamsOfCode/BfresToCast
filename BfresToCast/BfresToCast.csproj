<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>Icon\Bfres.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="Icon\Bfres.ico" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BfresLibrary">
          <HintPath>ThirdParty\BfresLibrary.dll</HintPath>
        </Reference>
        <Reference Include="Cast.NET">
          <HintPath>ThirdParty\Cast.NET.dll</HintPath>
        </Reference>
        <Reference Include="ImageLibrary">
          <HintPath>ThirdParty\ImageLibrary.dll</HintPath>
        </Reference>
        <Reference Include="Syroot.BinaryData">
          <HintPath>ThirdParty\Syroot.BinaryData.dll</HintPath>
        </Reference>
        <Reference Include="Syroot.Maths">
          <HintPath>ThirdParty\Syroot.Maths.dll</HintPath>
        </Reference>
        <Reference Include="Syroot.NintenTools.NSW.Bntx">
          <HintPath>ThirdParty\Syroot.NintenTools.NSW.Bntx.dll</HintPath>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="BCnEncoder.Net" Version="2.1.0" />
        <PackageReference Include="SarcLibrary" Version="3.3.4" />
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
        <PackageReference Include="ZstdNet" Version="1.4.5" />
    </ItemGroup>
    <ItemGroup>
      <None Update="tegra_swizzle_x64.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="tegra_swizzle_x86.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="libzstd.so">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\libtegra_swizzle.so">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\libimage_dds.so">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\libRG_ETC1.so">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\RG_ETC1.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\ImageLibrary.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\BCnEncoder.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\Syroot.Maths.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\Syroot.NintenTools.NSW.Bntx.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\Syroot.BinaryData.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\BfresLibrary.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="ThirdParty\Cast.NET.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
