<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>Icon\Bfres.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="Icon\Bfres.ico" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BCnEncoder">
          <HintPath>ThirdParty\BCnEncoder.dll</HintPath>
        </Reference>
        <Reference Include="BfresLibrary">
          <HintPath>ThirdParty\BfresLibrary.dll</HintPath>
        </Reference>
        <Reference Include="Cast.NET">
          <HintPath>ThirdParty\Cast.NET.dll</HintPath>
        </Reference>
        <Reference Include="ImageLibrary">
          <HintPath>ThirdParty\ImageLibrary.dll</HintPath>
        </Reference>
        <Reference Include="Syroot.BinaryData">
          <HintPath>ThirdParty\Syroot.BinaryData.dll</HintPath>
        </Reference>
        <Reference Include="Syroot.Maths">
          <HintPath>ThirdParty\Syroot.Maths.dll</HintPath>
        </Reference>
        <Reference Include="Syroot.NintenTools.NSW.Bntx">
          <HintPath>ThirdParty\Syroot.NintenTools.NSW.Bntx.dll</HintPath>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AstcEncoderCSharp" Version="5.4.3" />
        <PackageReference Include="BymlLibrary" Version="2.1.18" />
        <PackageReference Include="SarcLibrary" Version="3.3.5" />
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
        <PackageReference Include="ZstdNet" Version="1.5.7" />
    </ItemGroup>
  <ItemGroup>
    <None Update="ThirdParty\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="ExternalTextureFolders.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
